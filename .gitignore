.next/
out/
dist/
build/
.DS_Store

# ignore all env files except env.example templates
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# tooling local
.claude/
.cursor/
.vscode/
.gemini/
.opencode/
.agents/
tsconfig.tsbuildinfo
*.log

# notas locales del proyecto (config de agentes IA, local a cada dev)
CLAUDE.md
AGENTS.md
# excepción: la doc de agentes/skills SÍ se versiona
!docs/AGENTS.md

# autogenerado por Next.js (se regenera en cada build)
next-env.d.ts

# datos de runtime / código muerto (ver docs/ROADMAP.md R4) — no versionar
apps/api/src/data/*.json

# certs locales mkcert (HTTPS LAN para WebUSB / impresora en tablet)
apps/web/certs/

# Android shell
apps/caja-android/local.properties
apps/caja-android/.gradle/
apps/caja-android/**/build/
apps/caja-android/*.iml
apps/caja-android/.idea/


# reporte de cobertura de tests (generado por vitest --coverage)
coverage/

# generado por supabase/generate-keys.mjs desde kong.yml.template (ver
# docs/specs/deuda-pre-fase-6/hardening-kong-demo-keys.md) — el template SÍ se versiona, esto no.
supabase/docker/kong.yml

# estado local del CLI de Supabase (no versionar)
supabase/.temp/
**/.branches/

# referencias de diseño locales
docs/design/reference/*.png

# Capturas/snapshots del MCP de Playwright
.playwright-mcp/

# Volcados de db:delete-night — datos reales de una noche, nunca al repo
backups/
