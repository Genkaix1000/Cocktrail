# ──────────────────────────────────────────────────────────────────────
# Template de variables de entorno.
# Copialo a `.env.local` y completá los valores:
#   cp .env.example .env.local
#
# `.env.local` está gitignored. `.env.example` se commitea como referencia.
# ──────────────────────────────────────────────────────────────────────

# HMAC secret usado para firmar la cookie de sesión `cocktrail_session`.
# Si no se setea, usa un fallback de desarrollo. Para producción / demo público:
#   openssl rand -hex 32
COCKTRAIL_AUTH_SECRET=

# Credenciales del panel staff (opcional — defaults hardcoded: admin/admin y barman/barman).
# Útil si vas a hacer la demo en un boliche real y querés un user/pass distintos.
COCKTRAIL_ADMIN_USER=admin
COCKTRAIL_ADMIN_PASS=admin
COCKTRAIL_BARMAN_USER=barman
COCKTRAIL_BARMAN_PASS=barman

# Host base que codifica el QR (lo escanea el celu del cliente). Si no se setea,
# fallback a window.location.origin del browser — funciona si abrís /admin/qr
# desde otra LAN device, pero NO sirve si lo abrís desde "localhost".
# Obtener tu IP LAN:  ip route get 1.1.1.1 | grep -oP 'src \K[\d.]+'
# El prefix NEXT_PUBLIC_ inlinea el valor en el bundle del cliente (intencional).
NEXT_PUBLIC_LAN_HOST=http://iplan:3000
