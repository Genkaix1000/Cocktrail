# ──────────────────────────────────────────────────────────────────────
# Template raíz (legacy / referencia rápida).
# Las apps usan sus propios env:
#   cp apps/api/.env.example apps/api/.env
#   cp apps/web/.env.example apps/web/.env
#   cp supabase/.env.example supabase/.env   # opcional (override del compose)
#
# `.env` está gitignored. Los `.env.example` se commitean como referencia.
# ──────────────────────────────────────────────────────────────────────

# Preferí configurar AUTH_SECRET en apps/api/.env y apps/web/.env (deben coincidir).
# Este archivo raíz no lo lee el monorepo por defecto.
COCKTRAIL_AUTH_SECRET=

# Host base que codifica el QR (lo escanea el celu del cliente).
# Preferí NEXT_PUBLIC_LAN_HOST en apps/web/.env.
# NEXT_PUBLIC_LAN_HOST=http://192.168.1.50:3000
