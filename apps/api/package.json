{
  "name": "cocktrail-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:reset": "tsx src/scripts/reset-data.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "verify-sync": "tsx src/scripts/verify-sync.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --exclude '**/tests/integration/**'",
    "test:integration": "INTEGRATION=1 vitest run tests/integration",
    "test:coverage": "vitest run --exclude '**/tests/integration/**' --coverage --coverage.clean=true && INTEGRATION=1 vitest run tests/integration --coverage --coverage.clean=false"
  },
  "dependencies": {
    "@cocktrail/shared": "workspace:*",
    "@supabase/supabase-js": "^2.108.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "pg": "^8.22.0",
    "zod": "^3.25.20"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
