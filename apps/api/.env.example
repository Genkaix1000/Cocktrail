# ──────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno para apps/api
# Copia este archivo a `.env` en este mismo directorio y completa los valores.
# `.env` está en el .gitignore y nunca debe ser commiteado al repositorio.
# ──────────────────────────────────────────────────────────────────────

# Entorno de ejecución (development, production, test)
NODE_ENV=development

# Puerto donde corre el servidor de la API
PORT=3001

# Secreto de autenticación HMAC (mínimo 32 caracteres)
# Para producción, genera un secreto fuerte usando: openssl rand -hex 32
AUTH_SECRET="dev-secret-change-me-in-production-longer-than-32-chars"
COCKTRAIL_AUTH_SECRET="dev-secret-change-me-in-production-longer-than-32-chars"

# URL del frontend para habilitar CORS
FRONTEND_URL="http://localhost:3000"

# Credenciales opcionales para los roles de Staff (por defecto en desarrollo)
ADMIN_USER=admin
ADMIN_PASS=admin
CAJA_USER=caja
CAJA_PASS=caja

# Código por defecto de la estación de barra (fallback si el cliente no envía uno)
BAR_CODE=BARRA-01

# Supabase Local DB Config
# Apunta al gateway Kong del stack docker-compose.yml de la raíz.
# SUPABASE_SERVICE_ROLE_KEY es un JWT del rol service_role firmado con el
# JWT secret local (demo). DEBE matchear SERVICE_ROLE_KEY de
# supabase/.env.example y las `key:` de supabase/docker/kong.yml. Si rotás el
# JWT secret, regenerá esta llave (ver docs/DEPLOY.md).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.4HviqYnTKiRK-RJvWzgAAuaFiq8--foTrXQpl7HYMU4

# Supabase Cloud Sync (Optional) — también requerido para OAuth MP (Fase 1)
# SUPABASE_CLOUD_URL=https://your-project.supabase.co
# SUPABASE_CLOUD_SERVICE_ROLE_KEY=your-cloud-service-role-key

# Postgres directo — SOLO lo usa el runner de migraciones del boot (infra/migrations).
# Default: el Postgres del docker-compose local (puerto host 54322, password "postgres").
# Si overrideaste POSTGRES_PASSWORD o POSTGRES_EXTERNAL_PORT en supabase/.env, ajustá acá.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# ── Mercado Pago ──────────────────────────────────────────────────────
# MP_ACCESS_TOKEN — FALLBACK DE EMERGENCIA (F1), NO la credencial principal.
# El cobro normal sale por el seller vinculado vía OAuth (token cifrado en la
# base local). Este token de la env solo cobra cuando ese seller falla o no
# existe: instalación nueva sin OAuth, o restore de un backup (que por diseño
# NO recupera el token — D3 en docs/specs/mercadopago/).
# Para que sirva tiene que cumplir dos condiciones, que el sistema VERIFICA
# (preflight al boot; se ve en /api/system/health → mpFallback y en /admin):
#   1. Ser de la MISMA cuenta de MP que el lector (si no, la plata iría a otra
#      cuenta y el resolver se niega a degradar).
#   2. Que el lector (MP_POS_DEVICE_ID) figure en su listado de devices.
# Pregunta abierta (ver spec F1.c): no está determinado si una app de MP de
# tipo distinto a "Pagos presenciales" falla recién en el POST del cobro —
# el preflight declara "usable" como "no encontré motivo para que no sirva".
# MP_ACCESS_TOKEN=APP_USR-...
# MP_POS_DEVICE_ID=PAX_A910__SMARTPOS...

# ── Mercado Pago — cifrado de tokens (PR 4) ───────────────────────────
# MP_TOKEN_SECRET: clave (ikm) del cifrado AES-256-GCM de los tokens del seller
# en la base LOCAL. Mínimo 32 chars — generar con: openssl rand -hex 48
# Si falta, se usa AUTH_SECRET. ⚠ Perderla = los tokens cifrados quedan
# ilegibles y hay que re-vincular por OAuth (el fallback de env sigue cobrando).
# MP_TOKEN_SECRET=

# MP_TOKEN_SECRET_PREVIOUS: SOLO durante una rotación de MP_TOKEN_SECRET —
# la clave anterior. El boot re-cifra todo con la actual y después se borra.
# MP_TOKEN_SECRET_PREVIOUS=

# MP_HANDOFF_KEY: secret del buzón de traspaso del OAuth (mercadopago_seller_handoff
# en Cloud). DEBE ser IDÉNTICA acá y en la Edge Function:
#   supabase secrets set MP_HANDOFF_KEY=<mismo valor>
# Si difieren, el pull falla con "handoff ilegible" (nunca en silencio).
# MP_HANDOFF_KEY=

# OAuth multi-seller (Fase 1, flujo cloud) — credenciales de la app Cocktrail en MP.
# El callback es una Edge Function en Supabase Cloud (supabase/functions/mp-auth-callback).
# El redirect_uri debe coincidir EXACTO con el configurado en "Tus integraciones" de MP
# y apuntar a la Edge Function cloud. oauth_states + mercadopago_sellers viven en Cloud:
# configurá SUPABASE_CLOUD_URL + SUPABASE_CLOUD_SERVICE_ROLE_KEY para que el backend escriba ahí.
# MP_APP_ID=1234567890                        # = client_id (APPID de la app de MP)
# MP_CLIENT_SECRET=...
# MP_REDIRECT_URI=https://<proyecto>.supabase.co/functions/v1/mp-auth-callback
# MP_REFRESH_MARGIN_DAYS=5                     # 1–7, días antes del vencimiento para refrescar

# Webhooks Orders API (Fase 6) — clave secreta generada en el panel de MP al configurar notificaciones.
# Sin esto, POST /api/mercadopago/webhooks responde 401.
# MP_WEBHOOK_SECRET=...
# Ventana de frescura del `ts` de la firma del webhook (anti-replay), en segundos.
# Un webhook con ts fuera de esta ventana se rechaza con 401. Requiere reloj razonable (NTP).
# MP_WEBHOOK_TS_TOLERANCE_SECONDS=300
