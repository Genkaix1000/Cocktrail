# ──────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno para apps/api
# Copia este archivo a `.env` en este mismo directorio y completa los valores.
# `.env` está en el .gitignore y nunca debe ser commiteado al repositorio.
# ──────────────────────────────────────────────────────────────────────

# Entorno de ejecución (development, production, test)
NODE_ENV=development

# Puerto donde corre el servidor de la API
PORT=3001

# Secreto de autenticación HMAC (mínimo 32 caracteres)
# Para producción, genera un secreto fuerte usando: openssl rand -hex 32
AUTH_SECRET="dev-secret-change-me-in-production-longer-than-32-chars"
COCKTRAIL_AUTH_SECRET="dev-secret-change-me-in-production-longer-than-32-chars"

# URL del frontend para habilitar CORS
FRONTEND_URL="http://localhost:3000"

# Credenciales opcionales para los roles de Staff (por defecto en desarrollo)
ADMIN_USER=admin
ADMIN_PASS=admin
CAJA_USER=caja
CAJA_PASS=caja

# Código por defecto de la estación de barra (fallback si el cliente no envía uno)
BAR_CODE=BARRA-01

# Supabase Local DB Config
# Apunta al gateway Kong del stack docker-compose.yml de la raíz.
# SUPABASE_SERVICE_ROLE_KEY es un JWT del rol service_role firmado con el
# JWT secret local (demo). DEBE matchear SERVICE_ROLE_KEY de
# supabase/.env.example y las `key:` de supabase/docker/kong.yml. Si rotás el
# JWT secret, regenerá esta llave (ver docs/DEPLOY.md).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.4HviqYnTKiRK-RJvWzgAAuaFiq8--foTrXQpl7HYMU4

# Supabase Cloud Sync (Optional)
# SUPABASE_CLOUD_URL=https://your-project.supabase.co
# SUPABASE_CLOUD_SERVICE_ROLE_KEY=your-cloud-service-role-key

