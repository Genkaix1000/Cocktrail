# ──────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno para apps/web (Next.js)
# Copia este archivo a `.env` en este mismo directorio y completa los valores.
# `.env` está en el .gitignore y nunca debe ser commiteado al repositorio.
# ──────────────────────────────────────────────────────────────────────

# URL de la API (Backend). Usada para peticiones del lado del cliente y servidor.
# En desarrollo suele ser: http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Secreto de autenticación HMAC. Debe coincidir EXACTAMENTE con el AUTH_SECRET de la API backend.
# Usado para validar localmente las cookies de sesión en el proxy Edge.
AUTH_SECRET="dev-secret-change-me-in-production-longer-than-32-chars"
COCKTRAIL_AUTH_SECRET="dev-secret-change-me-in-production-longer-than-32-chars"

# Código por defecto de la estación de barra (cada tablet puede sobreescribirlo en localStorage)
NEXT_PUBLIC_BAR_CODE=BARRA-01
