# ──────────────────────────────────────────────────────────────────────────
# Env del stack Docker de Supabase local (docker-compose.yml de la raíz).
#
# NO hace falta para correr: el compose ya trae estos valores como defaults
# embebidos, así que `docker compose up -d` funciona sin .env. Este archivo es
# solo para overridear (puertos, password, rotar llaves).
#
# Para usarlo:  cp supabase/.env.example supabase/.env
#               docker compose --env-file supabase/.env up -d
#
# IMPORTANTE: las 3 llaves de abajo son las DEMO keys ESTÁNDAR de Supabase
# self-hosting (PÚBLICAS: están en los docs oficiales, no son un secreto).
# ANON_KEY y SERVICE_ROLE_KEY son JWTs firmados con JWT_SECRET.
#
# Modelo de secretos:
#   - docker-compose.yml usa ${VAR:-<demo>}: lo VISIBLE en el compose son SOLO
#     los defaults demo (públicos). Las llaves reales van en ESTE archivo
#     (supabase/.env, gitignoreado) y overridean por env. El compose nunca
#     necesita un secreto real adentro.
#   - EXCEPCIÓN kong.yml: Kong declarativo DB-less NO lee env vars en el campo
#     `key` de key-auth. Por eso ahí las apikeys van LITERALES. Si rotás
#     JWT_SECRET tenés que regenerar ANON_KEY/SERVICE_ROLE_KEY (mismo secret) Y
#     reemplazar las `key:` dentro de supabase/docker/kong.yml a mano.
#     (Alternativa para no tocar kong.yml: renderizarlo con envsubst desde un
#     template en el arranque del contenedor — más piezas, no implementado.)
# ──────────────────────────────────────────────────────────────────────────

# Postgres
POSTGRES_PASSWORD=postgres
POSTGRES_EXTERNAL_PORT=54322

# JWT (firma de las apikeys). Demo secret estándar de Supabase.
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# apikey rol `anon` (acceso público — el backend NO la usa, queda por completitud)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.zQomPPgIVgwVRMh3NJhhAl2cJ-GKQgNXpMTbIKxKyoo

# apikey rol `service_role` (acceso total — ESTA es la que va en apps/api/.env
# como SUPABASE_SERVICE_ROLE_KEY). Debe matchear exactamente.
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.4HviqYnTKiRK-RJvWzgAAuaFiq8--foTrXQpl7HYMU4

# Puertos en el host
KONG_HTTP_PORT=54321
SUPABASE_PUBLIC_URL=http://localhost:54321
STUDIO_PORT=54323
